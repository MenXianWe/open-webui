# QLCodeChat runtime configuration.
# Copy this file to .env on the server and replace the placeholder values.

QLCODE_CHAT_DOCKER_TAG=latest
QLCODE_CHAT_PORT=3000

# Required. Generate one with:
# openssl rand -hex 32
QLCODE_CHAT_SECRET_KEY=replace-with-a-long-random-secret

# Use your public site origin when the service is exposed through a domain.
# Example: CORS_ALLOW_ORIGIN=https://chat.qlcodeapi.com
CORS_ALLOW_ORIGIN=https://qlcodeapi.com

# Keep "*" if the container is behind a trusted reverse proxy.
FORWARDED_ALLOW_IPS=*

# Privacy and telemetry controls.
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
