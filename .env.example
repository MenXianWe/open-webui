# QLCodeChat runtime configuration.
# Copy this file to .env on the server and replace the placeholder values.

QLCODE_CHAT_DOCKER_TAG=v0.9.8
QLCODE_CHAT_PORT=3000

# Local Docker build acceleration. Server runtime does not need these.
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
DEBIAN_APT_MIRROR=http://mirrors.aliyun.com/debian
DEBIAN_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security
PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
ONNXRUNTIME_NODE_INSTALL_CUDA=skip

# Required. Generate one with:
# openssl rand -hex 32
QLCODE_CHAT_SECRET_KEY=replace-with-a-long-random-secret

# Use your public site origin when the service is exposed through a domain.
# Example: CORS_ALLOW_ORIGIN=https://chat.qlcodeapi.com
CORS_ALLOW_ORIGIN=https://qlcodeapi.com
WEBUI_URL=https://chat.qlcodeapi.com/
QLCODE_TUTORIAL_URL=https://qlcodeapi.com/
ADMIN_EMAIL=qlcodeapi@qq.com

# Keep "*" if the container is behind a trusted reverse proxy.
FORWARDED_ALLOW_IPS=*

# QLCodeChat connection defaults.
ENABLE_SIGNUP=true
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=false
ENABLE_DIRECT_CONNECTIONS=true
ENABLE_EMAIL_VERIFICATION=false

# Login service terms defaults.
LOGIN_TERMS_ENABLED=true
LOGIN_TERMS_DISPLAY_STYLE=modal
LOGIN_TERMS_UPDATED_AT=2026-03-31

# Optional SMTP settings for registration email verification.
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@mail.qlcodeapi.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@mail.qlcodeapi.com
SMTP_FROM_NAME=QLCode API
SMTP_USE_TLS=true

# Privacy and telemetry controls.
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
